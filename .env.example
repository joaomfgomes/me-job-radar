# Copy to .env and fill in, then `chmod 600 .env`. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude API key for scoring and CV ingestion (starts with "sk-ant-").
# Create one at https://platform.claude.com/settings/keys
# Without it the app still runs, with the deterministic prefilter only.
ANTHROPIC_API_KEY=
